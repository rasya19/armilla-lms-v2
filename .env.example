# Copy this file to .env and configure your own PostgreSQL / Neon connection.
# Do not commit .env or share its contents.
DATABASE_URL=
# Direct (non-pooled) connection for Prisma migrations and other CLI commands.
DIRECT_URL=

# Production API requires the exact public HTTPS origin (no trailing slash).
# Configure the reverse proxy and frontend to serve /api from this same origin.
APP_ORIGIN=
# Production: generate 32 random bytes, encode as hex, and keep secret.
LOGIN_RATE_LIMIT_SECRET=
# Email for the one-time interactive master account creation command.
MASTER_ADMIN_EMAIL=
# Optional name; if blank, the command will ask for it.
MASTER_ADMIN_NAME=

# Reserved for SMTP invitations; email sending is not implemented yet.
# Configure these in the backend environment, never in the frontend.
SMTP_HOST=
SMTP_PORT=
# Use true for implicit TLS (typically port 465); false for STARTTLS (typically port 587).
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Reserved for the future n8n invitation webhook integration; not used yet.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_USERNAME=
N8N_WEBHOOK_PASSWORD=
=======
# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
