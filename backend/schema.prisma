generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Siswa {
  id               String             @id @default(uuid())
  nisn             String             @unique
  nama             String
  kelasId          String?
  email            String?
  telepon          String?
  status           String // "Aktif" | "Alumni" | "Cuti"
  sekolahId        String?
  sekolah          Sekolah?           @relation(fields: [sekolahId], references: [id])
  nik                  String?
  noKk                 String?
  tempatLahir          String?
  tanggalLahir         DateTime?          @db.Date
  jenisKelamin         String?
  jenjang              String?
  tanggalMasuk         DateTime?          @db.Date
  jalurPendaftaran     String?
  namaAyah             String?
  teleponAyah          String?
  pekerjaanAyah        String?
  namaIbu              String?
  namaIbuKandung       String?
  teleponIbu           String?
  pekerjaanIbu         String?
  namaWali             String?
  teleponWali          String?
  pekerjaanWali        String?
  alamatLengkap        String?
  desaKelurahan        String?
  kecamatan            String?
  sekolahAsal          String?
  npsnAsal             String?
  nomorIjazahTerakhir String?
  urlKk                String?
  urlAktaKtp           String?
  urlIjazah            String?
  urlSuratPindah       String?
  sumberDapodik        Boolean            @default(false)
  statusVerval         String             @default("BELUM_LENGKAP")
  catatanVerval        String?
  statusVervalDinas    String             @default("MENUNGGU_DINAS")
  catatanDinas         String?
  akun                 Akun?
  pendaftaran          PPDB?
  kehadiran            Presensi[]
  pengumpulan          PengumpulanTugas[]
  percobaan            PercobaanUjian[]

  @@index([sekolahId])
  @@index([sekolahId, statusVerval])
  @@index([sekolahId, statusVervalDinas])
}

model Guru {
  id         String            @id @default(uuid())
  nuptk      String?           @unique
  nama       String
  mapelUtama String
  email      String
  telepon    String
  status     String // "Aktif" | "Nonaktif"
  sekolahId  String?
  sekolah    Sekolah?          @relation(fields: [sekolahId], references: [id])
  akun       Akun?
  jadwal     JadwalPelajaran[]
  agenda     AgendaMengajar[]
  materi     MateriAjar[]
  tugas      Tugas[]
  ujian      Ujian[]

  @@index([sekolahId])
}

model Mapel {
  id        String            @id @default(uuid())
  kode      String            @unique
  nama      String
  kkm       Int
  sekolahId String?
  sekolah   Sekolah?          @relation(fields: [sekolahId], references: [id])
  jadwal    JadwalPelajaran[]
  agenda    AgendaMengajar[]
  materi    MateriAjar[]
  tugas     Tugas[]
  ujian     Ujian[]

  @@index([sekolahId])
}

model Kelas {
  id         String            @id @default(uuid())
  kode       String            @unique
  nama       String
  waliGuruId String?
  sekolahId  String?
  sekolah    Sekolah?          @relation(fields: [sekolahId], references: [id])
  jadwal     JadwalPelajaran[]
  agenda     AgendaMengajar[]
  presensi   Presensi[]
  materi     MateriAjar[]
  tugas      Tugas[]
  ujian      Ujian[]

  @@index([sekolahId])
}

model PPDB {
  id              String    @id @default(uuid())
  noDaftar        String    @unique
  nama            String
  email           String
  telepon         String
  alamat          String
  jenjang         String
  status          String // "Pending" | "Diterima" | "Ditolak"
  tanggalDaftar   DateTime  @default(now())
  dokumen         Json?
  sekolahId       String?
  sekolah         Sekolah?  @relation(fields: [sekolahId], references: [id])
  siswaId         String?   @unique
  siswa           Siswa?    @relation(fields: [siswaId], references: [id])
  ditinjauPada    DateTime?
  ditinjauOlehId  String?
  ditinjauOleh    Akun?     @relation("PeninjauPPDB", fields: [ditinjauOlehId], references: [id])
  catatanTinjauan String?

  @@index([sekolahId, status])
}

model Nilai {
  id              String   @id @default(uuid())
  siswaId         String
  mapelId         String
  nilaiMandiri    Float
  nilaiSimulasi   Float
  nilaiAkhir      Float
  tanggalSimulasi DateTime @default(now())
  tahunAjaranId   String?
  catatanKompetensi String?
  sekolahId       String?
  sekolah         Sekolah? @relation(fields: [sekolahId], references: [id])

  @@index([sekolahId, siswaId])
}

model WebsiteSettings {
  school_id     String   @id
  primary_color String   @default("#4f46e5")
  logo_url      String?
  hero_title    String?
  hero_subtitle String?
  show_gallery  Boolean  @default(true)
  show_news     Boolean  @default(true)
  footer_text   String?
  updated_at    DateTime @updatedAt
}

model RefKabupaten {
  id        String         @id
  kode      String         @unique
  nama      String
  provinsi  String         @default("Jawa Barat")
  kecamatan RefKecamatan[]
}

model RefKecamatan {
  id          String       @id
  kabupatenId String
  kode        String       @unique
  nama        String
  kabupaten   RefKabupaten @relation(fields: [kabupatenId], references: [id], onDelete: Cascade)
}

enum StatusPendaftaranSekolah {
  MENUNGGU
  DISETUJUI
  DITOLAK
}

enum StatusTenant {
  ACTIVE
  SUSPENDED
}

model PendaftaranSekolah {
  id              String                    @id @default(uuid())
  namaSekolah     String
  npsn            String?
  wilayah         String?
  namaKontak      String
  emailKontak     String
  teleponKontak   String
  status          StatusPendaftaranSekolah @default(MENUNGGU)
  paket           String?
  catatanTinjauan String?
  dibuatPada      DateTime                  @default(now())
  ditinjauPada    DateTime?
  ditinjauOlehId  String?
  ditinjauOleh    Akun?                     @relation("PeninjauSekolah", fields: [ditinjauOlehId], references: [id])
  sekolahId       String?                   @unique
  sekolah         Sekolah?                  @relation(fields: [sekolahId], references: [id])

  @@index([status, dibuatPada])
}

model Sekolah {
  id                 String                @id @default(uuid())
  nama               String
  slug               String                @unique
  npsn               String?               @unique
  status             StatusTenant          @default(ACTIVE)
  expiresAt          DateTime?
  plan               String?
  kelasStandarDibuat Boolean               @default(false)
  themeKey           String                @default("ocean")
  adminPhone         String?
  kabupatenKota         String?
  izinVervalDinas       Boolean               @default(true)
  tanggalCutOffDapodik  DateTime?             @db.Date
  alamatSekolah         String?
  namaKepalaSekolah     String?
  namaOperatorDapodik   String?
  totalSiswaDapodik     Int                   @default(0)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  akun               Akun[]
  siswa              Siswa[]
  guru               Guru[]
  mapel              Mapel[]
  kelas              Kelas[]
  ppdb               PPDB[]
  nilai              Nilai[]
  tahunAjaran        TahunAjaran[]
  jadwal             JadwalPelajaran[]
  agenda             AgendaMengajar[]
  presensi           Presensi[]
  materi             MateriAjar[]
  tugas              Tugas[]
  berkas             Berkas[]
  ujian              Ujian[]
  modulKesetaraan    ModulKesetaraan[]
  catatanRaport      CatatanRaport[]
  cbtPengaturan      CbtPengaturan?
  instrumenSnp       InstrumenSnp[]
  tagihanSpp         TagihanSpp[]
  pembayaranSpp      PembayaranSpp[]
  alumniTracer       AlumniTracer[]
  asetSarpras        AsetSarpras[]
  topikDiskusi       TopikDiskusi[]
  pendaftaranLembaga PendaftaranSekolah?

  @@index([kabupatenKota, izinVervalDinas])
}

enum PeranAkun {
  MASTER_ADMIN
  ADMIN
  GURU
  SISWA
  DINAS
}

model Akun {
  id                 String               @id @default(uuid())
  sekolahId          String?
  sekolah            Sekolah?             @relation(fields: [sekolahId], references: [id])
  email              String?              @unique
  nama               String
  passwordHash       String
  peran              PeranAkun
  wilayahKabupaten   String?
  aktif              Boolean              @default(true)
  wajibGantiPassword Boolean              @default(false)
  siswaId            String?              @unique
  siswa              Siswa?               @relation(fields: [siswaId], references: [id])
  guruId             String?              @unique
  guru               Guru?                @relation(fields: [guruId], references: [id])
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  sesi               SesiAkun[]
  tinjauan           PPDB[]               @relation("PeninjauPPDB")
  tinjauanSekolah    PendaftaranSekolah[] @relation("PeninjauSekolah")
  berkas             Berkas[]

  @@index([sekolahId, peran])
}

model SesiAkun {
  id        String    @id @default(uuid())
  akunId    String
  akun      Akun      @relation(fields: [akunId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([akunId, expiresAt])
}

model LoginRateLimit {
  key       String   @id
  count     Int
  expiresAt DateTime @db.Timestamptz(6)

  @@index([expiresAt])
}

model TahunAjaran {
  id        String            @id @default(uuid())
  sekolahId String
  sekolah   Sekolah           @relation(fields: [sekolahId], references: [id])
  nama      String
  semester  String
  mulai     DateTime          @db.Date
  selesai   DateTime          @db.Date
  jadwal    JadwalPelajaran[]
  agenda    AgendaMengajar[]
  presensi  Presensi[]
  materi    MateriAjar[]
  tugas     Tugas[]
  ujian     Ujian[]

  @@unique([sekolahId, nama, semester])
}

model JadwalPelajaran {
  id            String      @id @default(uuid())
  sekolahId     String
  sekolah       Sekolah     @relation(fields: [sekolahId], references: [id])
  tahunAjaranId String
  tahunAjaran   TahunAjaran @relation(fields: [tahunAjaranId], references: [id])
  kelasId       String
  kelas         Kelas       @relation(fields: [kelasId], references: [id])
  mapelId       String
  mapel         Mapel       @relation(fields: [mapelId], references: [id])
  guruId        String
  guru          Guru        @relation(fields: [guruId], references: [id])
  hari          Int
  jamMulai      String
  jamSelesai    String
  ruangan       String?

  @@index([sekolahId, tahunAjaranId, kelasId, hari])
}

model AgendaMengajar {
  id              String      @id @default(uuid())
  sekolahId       String
  sekolah         Sekolah     @relation(fields: [sekolahId], references: [id])
  tahunAjaranId   String
  tahunAjaran     TahunAjaran @relation(fields: [tahunAjaranId], references: [id])
  kelasId         String
  kelas           Kelas       @relation(fields: [kelasId], references: [id])
  mapelId         String
  mapel           Mapel       @relation(fields: [mapelId], references: [id])
  guruId          String
  guru            Guru        @relation(fields: [guruId], references: [id])
  tanggal         DateTime    @db.Date
  jamKe           String
  metode          String      @default("TATAP_MUKA")
  materiPokok     String
  hadirCount      Int         @default(0)
  tidakHadirCount Int         @default(0)
  catatanGuru     String?
  createdAt       DateTime    @default(now())

  @@index([sekolahId, kelasId, tanggal])
}

enum StatusPresensi {
  HADIR
  SAKIT
  IZIN
  ALPA
}

model Presensi {
  id            String         @id @default(uuid())
  sekolahId     String
  sekolah       Sekolah        @relation(fields: [sekolahId], references: [id])
  tahunAjaranId String
  tahunAjaran   TahunAjaran    @relation(fields: [tahunAjaranId], references: [id])
  kelasId       String
  kelas         Kelas          @relation(fields: [kelasId], references: [id])
  siswaId       String
  siswa         Siswa          @relation(fields: [siswaId], references: [id])
  tanggal       DateTime       @db.Date
  status        StatusPresensi
  keterangan    String?
  waktuHadir    DateTime?
  updatedAt     DateTime       @updatedAt

  @@unique([sekolahId, siswaId, tanggal])
  @@index([sekolahId, kelasId, tanggal])
}

model Berkas {
  id             String             @id @default(uuid())
  sekolahId      String
  sekolah        Sekolah            @relation(fields: [sekolahId], references: [id])
  diunggahOlehId String
  diunggahOleh   Akun               @relation(fields: [diunggahOlehId], references: [id])
  storageKey     String             @unique
  nama           String
  contentType    String
  ukuranBytes    Int
  createdAt      DateTime           @default(now())
  materi         MateriAjar[]
  tugas          Tugas[]
  pengumpulan    PengumpulanTugas[]

  @@index([sekolahId])
}

model MateriAjar {
  id            String      @id @default(uuid())
  sekolahId     String
  sekolah       Sekolah     @relation(fields: [sekolahId], references: [id])
  tahunAjaranId String
  tahunAjaran   TahunAjaran @relation(fields: [tahunAjaranId], references: [id])
  kelasId       String
  kelas         Kelas       @relation(fields: [kelasId], references: [id])
  mapelId       String
  mapel         Mapel       @relation(fields: [mapelId], references: [id])
  guruId        String
  guru          Guru        @relation(fields: [guruId], references: [id])
  judul         String
  deskripsi     String?
  jenis         String
  tautan        String?
  berkasId      String?
  berkas        Berkas?     @relation(fields: [berkasId], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([sekolahId, kelasId, mapelId])
}

model Tugas {
  id            String             @id @default(uuid())
  sekolahId     String
  sekolah       Sekolah            @relation(fields: [sekolahId], references: [id])
  tahunAjaranId String
  tahunAjaran   TahunAjaran        @relation(fields: [tahunAjaranId], references: [id])
  kelasId       String
  kelas         Kelas              @relation(fields: [kelasId], references: [id])
  mapelId       String
  mapel         Mapel              @relation(fields: [mapelId], references: [id])
  guruId        String
  guru          Guru               @relation(fields: [guruId], references: [id])
  judul         String
  instruksi     String?
  batasWaktu    DateTime?
  berkasId      String?
  berkas        Berkas?            @relation(fields: [berkasId], references: [id])
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  pengumpulan   PengumpulanTugas[]

  @@index([sekolahId, kelasId, batasWaktu])
}

model PengumpulanTugas {
  id              String   @id @default(uuid())
  tugasId         String
  tugas           Tugas    @relation(fields: [tugasId], references: [id])
  siswaId         String
  siswa           Siswa    @relation(fields: [siswaId], references: [id])
  jawaban         String?
  tautan          String?
  berkasId        String?
  berkas          Berkas?  @relation(fields: [berkasId], references: [id])
  dikumpulkanPada DateTime @default(now())
  nilai           Float?
  catatanGuru     String?

  @@unique([tugasId, siswaId])
}

model Ujian {
  id                 String           @id @default(uuid())
  sekolahId          String
  sekolah            Sekolah          @relation(fields: [sekolahId], references: [id])
  tahunAjaranId      String
  tahunAjaran        TahunAjaran      @relation(fields: [tahunAjaranId], references: [id])
  kelasId            String
  kelas              Kelas            @relation(fields: [kelasId], references: [id])
  mapelId            String
  mapel              Mapel            @relation(fields: [mapelId], references: [id])
  guruId             String
  guru               Guru             @relation(fields: [guruId], references: [id])
  kode               String
  judul              String
  durasiMenit        Int
  mulai              DateTime
  selesai            DateTime
  kkm                Float
  tokenHash          String?
  tokenKode          String?
  acakSoal           Boolean          @default(true)
  acakOpsi           Boolean          @default(true)
  tampilNilai        Boolean          @default(true)
  toleransiKeluarTab Int              @default(3)
  dipublikasikan     Boolean          @default(false)
  createdAt          DateTime         @default(now())
  soal               SoalUjian[]
  percobaan          PercobaanUjian[]

  @@unique([sekolahId, kode])
  @@index([sekolahId, kelasId, mulai])
}

model SoalUjian {
  id         String         @id @default(uuid())
  ujianId    String
  ujian      Ujian          @relation(fields: [ujianId], references: [id], onDelete: Cascade)
  urutan     Int
  tipe       String         @default("PG")
  teks       String
  bobot      Int            @default(10)
  kunciEsai  String?
  pembahasan String?
  opsi       OpsiSoal[]
  jawaban    JawabanUjian[]

  @@unique([ujianId, urutan])
}

model OpsiSoal {
  id      String         @id @default(uuid())
  soalId  String
  soal    SoalUjian      @relation(fields: [soalId], references: [id], onDelete: Cascade)
  kode    String
  teks    String
  benar   Boolean        @default(false)
  jawaban JawabanUjian[]

  @@unique([soalId, kode])
}

model PercobaanUjian {
  id              String         @id @default(uuid())
  ujianId         String
  ujian           Ujian          @relation(fields: [ujianId], references: [id], onDelete: Cascade)
  siswaId         String
  siswa           Siswa          @relation(fields: [siswaId], references: [id])
  status          String         @default("SEDANG_MENGERJAKAN")
  dimulaiPada     DateTime       @default(now())
  dikumpulkanPada DateTime?
  nilai           Float?
  nilaiOverride   Float?
  catatanGuru     String?
  tabViolations   Int            @default(0)
  jawaban         JawabanUjian[]

  @@unique([ujianId, siswaId])
}

model JawabanUjian {
  id          String         @id @default(uuid())
  percobaanId String
  percobaan   PercobaanUjian @relation(fields: [percobaanId], references: [id], onDelete: Cascade)
  soalId      String
  soal        SoalUjian      @relation(fields: [soalId], references: [id], onDelete: Cascade)
  opsiId      String?
  opsi        OpsiSoal?      @relation(fields: [opsiId], references: [id])
  jawabanEsai String?
  raguRagu    Boolean        @default(false)

  @@unique([percobaanId, soalId])
}

model ModulKesetaraan {
  id            String   @id @default(uuid())
  sekolahId     String
  sekolah       Sekolah  @relation(fields: [sekolahId], references: [id])
  mapelId       String?
  jenjang       String // "PAKET_A" | "PAKET_B" | "PAKET_C"
  tingkatan     String // e.g., "Kelas 1-3", "Kelas 7", "Kelas 12"
  kelompok      String // "UMUM" | "PEMBERDAYAAN" | "KETERAMPILAN"
  kodeModul     String
  judulModul    String
  skkTatapMuka  Int      @default(2)
  skkTutorial   Int      @default(1)
  skkMandiri    Int      @default(1)
  skkTotal      Int      @default(4)
  deskripsi     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([sekolahId, jenjang, kelompok])
}

model CatatanRaport {
  id            String    @id @default(uuid())
  sekolahId     String
  sekolah       Sekolah   @relation(fields: [sekolahId], references: [id])
  tahunAjaranId String
  kelasId       String
  siswaId       String
  catatanWali   String?
  statusKenaikan String   @default("PROSES") // "PROSES" | "NAIK_KELAS" | "LULUS" | "TINGGAL_KELAS"
  tanggalRapor  DateTime?
  updatedAt     DateTime  @updatedAt

  @@unique([sekolahId, tahunAjaranId, siswaId])
  @@index([sekolahId, kelasId])
}

model CbtPengaturan {
  sekolahId                String   @id
  sekolah                  Sekolah  @relation(fields: [sekolahId], references: [id])
  acakUrutanSoal           Boolean  @default(true)
  acakOpsiJawaban          Boolean  @default(true)
  tampilkanNilaiLangsung   Boolean  @default(true)
  batasToleransiKeluarTab  Int      @default(3)
  kkmDefault               Float    @default(75)
  wajibToken               Boolean  @default(true)
  updatedAt                DateTime @updatedAt
}

model InstrumenSnp {
  id                String   @id @default(uuid())
  sekolahId         String
  sekolah           Sekolah  @relation(fields: [sekolahId], references: [id])
  standarKode       String // "SNP-1" .. "SNP-8"
  standarNama       String
  indikator         String
  statusDokumen     String   @default("BELUM_ADA") // "BELUM_ADA" | "PROSES" | "LENGKAP"
  tautanBukti       String?
  catatanVerifikasi String?
  urutan            Int      @default(1)
  updatedAt         DateTime @updatedAt

  @@index([sekolahId, standarKode])
}

model TagihanSpp {
  id         String          @id @default(uuid())
  sekolahId  String
  sekolah    Sekolah         @relation(fields: [sekolahId], references: [id])
  siswaId    String
  kelasId    String?
  judul      String
  kategori   String // "SPP_BULANAN" | "UANG_UJIAN" | "DAFTAR_ULANG" | "SERAGAM_MODUL" | "LAINNYA"
  periode    String?
  nominal    Int
  jatuhTempo DateTime?       @db.Date
  status     String          @default("BELUM_BAYAR") // "BELUM_BAYAR" | "CICILAN" | "LUNAS"
  keterangan String?
  createdAt  DateTime        @default(now())
  pembayaran PembayaranSpp[]

  @@index([sekolahId, status])
  @@index([sekolahId, siswaId])
}

model PembayaranSpp {
  id            String     @id @default(uuid())
  sekolahId     String
  sekolah       Sekolah    @relation(fields: [sekolahId], references: [id])
  tagihanId     String
  tagihan       TagihanSpp @relation(fields: [tagihanId], references: [id], onDelete: Cascade)
  nomorKuitansi String     @unique
  jumlah        Int
  metode        String // "TUNAI" | "TRANSFER" | "QRIS"
  tanggalBayar  DateTime   @default(now())
  catatan       String?
  penerima      String?

  @@index([sekolahId, tanggalBayar])
}

model AlumniTracer {
  id                String   @id @default(uuid())
  sekolahId         String
  sekolah           Sekolah  @relation(fields: [sekolahId], references: [id])
  siswaId           String?  @unique
  nama              String
  nisn              String?
  program           String // "Paket A" | "Paket B" | "Paket C"
  tahunLulus        Int
  nomorIjazah       String?
  statusPascaLulus  String   @default("BEKERJA") // "BEKERJA" | "WIRAUSAHA" | "MELANJUTKAN_PENDIDIKAN" | "LAINNYA"
  namaInstansiUsaha String?
  kontakAktif       String?
  tahunMulai        Int?
  catatan           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([sekolahId, tahunLulus])
}

model AsetSarpras {
  id              String   @id @default(uuid())
  sekolahId       String
  sekolah         Sekolah  @relation(fields: [sekolahId], references: [id])
  kodeInventaris  String
  namaBarang      String
  kategori        String // "Elektronik" | "Meubelair" | "Alat Praktik" | "Gedung & Ruang" | "Lainnya"
  jumlah          Int      @default(1)
  kondisi         String   @default("BAIK") // "BAIK" | "RUSAK_RINGAN" | "RUSAK_BERAT"
  lokasiRuangan   String
  tahunPengadaan  Int
  sumberPengadaan String // "BOSP" | "Mandiri" | "Hibah" | "Lainnya"
  catatan         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([sekolahId, kodeInventaris])
  @@index([sekolahId, kategori])
}

model TopikDiskusi {
  id           String           @id @default(uuid())
  sekolahId    String
  sekolah      Sekolah          @relation(fields: [sekolahId], references: [id])
  kelasId      String?
  kategori     String           @default("UMUM") // "UMUM" | "KELAS" | "PENGUMUMAN"
  judul        String
  isi          String
  penulisNama  String
  penulisPeran String // "ADMIN" | "GURU" | "SISWA"
  disematkan   Boolean          @default(false)
  ditutup      Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  balasan      BalasanDiskusi[]

  @@index([sekolahId, disematkan, createdAt])
}

model BalasanDiskusi {
  id           String       @id @default(uuid())
  sekolahId    String
  topikId      String
  topik        TopikDiskusi @relation(fields: [topikId], references: [id], onDelete: Cascade)
  isi          String
  penulisNama  String
  penulisPeran String // "ADMIN" | "GURU" | "SISWA"
  terbaik      Boolean      @default(false)
  createdAt    DateTime     @default(now())

  @@index([topikId, createdAt])
}

model SiteStat {
  id        String   @id
  visitors  Int      @default(0)
  updatedAt DateTime @updatedAt
}

model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model MasterModul {
  id            String   @id @default(uuid())
  jenjang       String // "PAKET_A" | "PAKET_B" | "PAKET_C"
  tingkatKelas  String   @default("")
  mataPelajaran String
  kategoriUjian String   @default("MATERI") // "MATERI" | "UTS" | "UAS" | "UJIAN_AKHIR"
  judul         String
  deskripsi     String?
  konten        String?
  fileUrl       String?
  jenis         String   @default("MODUL")
  aktif         Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([jenjang, mataPelajaran, kategoriUjian])
}

model MasterBankSoal {
  id            String            @id @default(uuid())
  jenjang       String // "PAKET_A" | "PAKET_B" | "PAKET_C"
  tingkatKelas  String            @default("")
  mataPelajaran String
  kategoriUjian String            @default("UTS") // "UTS" | "UAS" | "UJIAN_AKHIR"
  judul         String
  deskripsi     String?
  durasiMenit   Int               @default(60)
  kkm           Float             @default(75)
  aktif         Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  butirSoal     MasterButirSoal[]

  @@index([jenjang, mataPelajaran, kategoriUjian])
}

model MasterButirSoal {
  id           String         @id @default(uuid())
  bankSoalId   String
  bankSoal     MasterBankSoal @relation(fields: [bankSoalId], references: [id], onDelete: Cascade)
  urutan       Int
  tipe         String         @default("PG") // "PG" | "ESAI"
  teks         String
  bobot        Int            @default(10)
  opsiA        String?
  opsiB        String?
  opsiC        String?
  opsiD        String?
  opsiE        String?
  kunciJawaban String
  pembahasan   String?

  @@unique([bankSoalId, urutan])
}

