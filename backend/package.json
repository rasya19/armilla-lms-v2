{
  "name": "@armilla/backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch start.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/start.js",
    "lint": "tsc --noEmit",
    "test": "tsx --test password.test.ts school-registration.test.ts registration-routes.test.ts vercel-handler.test.ts master-production.test.ts student-import.test.ts school-input.test.ts class-input.test.ts academic-input.test.ts http-security.test.ts learning-input.test.ts login-session-validation.test.ts login-rate-limit.test.ts",
    "test:master-integration": "tsx --test master-production.test.ts",
    "test:login-integration": "tsx --test login-rate-limit.test.ts",
    "test:registration-integration": "tsx --test registration-routes.test.ts",
    "create:master": "tsx create-master.ts",
    "create:school-admin": "tsx create-school-admin.ts",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "7.9.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@prisma/config": "7.9.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.20.1",
    "prisma": "^7.9.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
